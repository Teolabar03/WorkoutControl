# Esempio senza credenziali. Non committare il tuo .env.
# Usa python install.py, oppure copia in .env e compila WORKOUT_PASSWORD.
# Riavvia dopo ogni modifica.

# Primo admin: usati solo quando non esiste alcuna utenza nel database.
# Dopo, utenti e password si gestiscono dall'app.
WORKOUT_USERNAME=admin
WORKOUT_PASSWORD=

# Solo computer locale. Per la rete domestica: 0.0.0.0 e firewall privato.
# Per internet: reverse proxy HTTPS (vedi README).
WORKOUT_HOST=127.0.0.1
WORKOUT_PORT=8456
# Debugger solo in sviluppo, mai su reti pubbliche.
WORKOUT_DEBUG=0

# Per cambiare database, preferire un percorso assoluto.
# WORKOUT_DB_PATH=
# Chiave generata automaticamente in instance/secret_key.txt se assente.
# WORKOUT_SECRET_KEY=

# Solo su HTTPS: cookie sicuri e prefisso pubblico, se presente.
# WORKOUT_COOKIE_SECURE=1
# WORKOUT_COOKIE_PATH=/workout/
# WORKOUT_COOKIE_NAME=workout_session
# Solo con un proxy fidato che riscrive gli header X-Forwarded-*.
# WORKOUT_PROXY_HOPS=1
# Di norma CORS non serve: Vite usa il proxy /api. Eventuali origini fidate
# devono essere esplicite, separate da virgole, senza wildcard.
# WORKOUT_FRONTEND_ORIGIN=

# AI facoltativa, disattivata. Le API remote ricevono dati di allenamento,
# peso, note sui dolori e conversazioni: leggi docs/privacy.md.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_MODEL=

# Ollama richiede il servizio avviato e il modello scaricato. Scegli un
# modello compatibile con strumenti e memoria disponibile. Vuoto = spento.
# Il provider/modello si sceglie nell'app. In automatico la precedenza e':
# Anthropic, Gemini, Ollama. Gemini puo' usare Ollama come riserva.
OLLAMA_MODEL=
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=32768
# OLLAMA_TIMEOUT=180
# OLLAMA_KEEP_ALIVE_CHAT=5m
# OLLAMA_THINK=0
# OLLAMA_EXE=

# Samsung Health: genera normalmente il token del workout da Impostazioni.
# Questa variabile serve solo a inizializzare il primo workout. Il telefono
# invia Authorization: Bearer <token> a /api/health/ingest tramite HTTPS.
# Senza token configurati, l'ingest resta disattivato.
# WORKOUT_INGEST_TOKEN=
