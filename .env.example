# Copia questo file in `.env` e compila quello che ti serve.

# --- Assistente AI (facoltativo) ---
# Basta configurare uno dei tre provider. Quale usare si sceglie dall'app (dalla
# barra della chat o da Impostazioni): appena una chiave e' presente, i modelli
# di quel provider compaiono da soli nell'elenco. Senza una scelta esplicita
# vale l'ordine di precedenza: Anthropic, poi Gemini, poi Ollama in locale.
# Senza nessuno dei tre, la sezione assistente sparisce dall'app e tutto
# il resto continua a funzionare.
#
# Le chiavi si leggono solo da qui e non vengono mai salvate nel database.
# Aggiungerne una richiede un riavvio dell'app; cambiare modello no.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modello predefinito di ciascun provider, usato finche' non ne scegli uno
# dall'interfaccia. Quello Gemini e' l'unico incluso nel piano gratuito.
# ANTHROPIC_MODEL=claude-opus-5
# GEMINI_MODEL=gemini-flash-latest

# --- Provider locale (Ollama) ---
# Richiede Ollama in esecuzione sul PC: nessuna chiave, nessuna quota, i dati
# di allenamento non escono dalla macchina. Valorizzare OLLAMA_MODEL lo attiva.
# Fa anche da riserva a Gemini: se la quota gratuita si esaurisce prima che
# l'assistente abbia modificato qualcosa, il turno viene rigiocato in locale.
#
# Questo e' il modello PREDEFINITO: da Impostazioni puoi sceglierne un altro
# fra quelli installati, senza riavviare l'app e senza toccare questo file.
# Serve comunque valorizzarlo, perche' e' la sua presenza ad attivare il
# provider locale.
#
# Sulla scelta contano due cose: quanto il modello e' affidabile con gli
# strumenti (l'assistente ne ha 24) e se entra nella memoria della scheda
# video. Quello che non ci sta finisce nella RAM di sistema e la risposta
# rallenta di parecchio, mentre il resto del PC arranca.
#   qwen3.5:9b        -> 6,6 GB: entra in una scheda da 8 GB in su. ~5 s a
#                        risposta, ma usa davvero lo strumento 3 volte su 5:
#                        nelle altre DESCRIVE la modifica senza eseguirla.
#                        Quando succede l'app lo sollecita una volta e, se non
#                        basta, te lo dice sotto la risposta. Ottimo per domande
#                        e analisi.
#   qwen2.5-coder:14b -> 9,0 GB: via di mezzo, entra in una scheda da 12 GB.
#                        Taratura sul codice, quindi in teoria piu' disciplinato
#                        con gli strumenti ma meno sciolto in italiano. Da
#                        misurare.
#   qwen3-coder:30b   -> 18,6 GB: serve una scheda da 20 GB per tenerlo tutto in
#                        VRAM. Usa lo strumento 5 volte su 5 e ci mette ~17 s.
#                        Da preferire se chiedi modifiche a schede e allenamenti
#                        e il computer non sta facendo altro.
# Non adatti: i modelli di ragionamento (deepseek-r1 e simili), perche' qui il
# "pensiero" e' disattivato di proposito (vedi OLLAMA_THINK) ed e' l'unica cosa
# per cui varrebbe la pena usarli; e i modelli di embedding (nomic-embed-text),
# che non sono conversazionali.
OLLAMA_MODEL=qwen3.5:9b

# Indirizzo del server Ollama (predefinito: http://127.0.0.1:11434).
# Meglio l'indirizzo numerico che "localhost": su Windows quel nome viene
# risolto prima in IPv6 e ogni chiamata ci perde due secondi.
# OLLAMA_HOST=

# Finestra di contesto per richiesta. Il numero di allenamenti inviati e'
# regolabile dall'interfaccia fino a 100: quando il contesto non li contiene
# tutti, l'app ne toglie da sola i piu' vecchi finche' non ci stanno (sotto la
# risposta trovi quanti ne ha visti davvero il modello). Alzare questo valore
# ne fa entrare di piu', ma costa VRAM.
# OLLAMA_NUM_CTX=32768

# Secondi concessi a una singola risposta locale. Serve a non lasciare la chat
# appesa quando il modello e' troppo grande per la scheda video e macina sulla
# CPU.
# OLLAMA_TIMEOUT=180

# Per quanto tempo il modello resta caricato in memoria dopo aver risposto.
# Volutamente diversa da OLLAMA_KEEP_ALIVE, che vale per tutto il server: qui
# si tratta solo delle risposte in chat, e tenere occupati diversi GB per mezz'ora
# dopo una domanda non ha senso su un PC che serve anche ad altro.
# OLLAMA_KEEP_ALIVE_CHAT=5m

# Lascia "pensare" il modello prima di rispondere. Disattivato di default:
# sui modelli di ragionamento il pensiero puo' allungarsi fino a saturare il
# contesto e bloccare la chat per minuti.
# OLLAMA_THINK=1

# --- Server ---
# 0.0.0.0 permette di aprire l'app dal telefono sulla stessa rete WiFi.
WORKOUT_HOST=0.0.0.0
WORKOUT_PORT=8456

# Percorso alternativo del database (predefinito: instance/workout.db)
# WORKOUT_DB_PATH=
